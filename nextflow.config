// FD-7531 — PIPELINE-level nextflow.config
//
// This file intentionally contains ONLY a `withName:` override.
// It deliberately does NOT redeclare any of the directives that the
// CE config sets at the top-level `process` scope (cpus, ext.from_ce,
// ext.shared_key, scratch). If Seqera Platform truly merges the two
// configs at runtime, all CE-level process defaults should still apply
// to BASE_DEFAULTS, and OVERRIDE_ME should only differ in the keys we
// set below.

manifest {
    name            = 'minimal-platform-test'
    description     = 'FD-7531 — CE config + pipeline config merge test'
    version         = '1.0.0'
    nextflowVersion = '>=23.0.0'
}

docker.enabled = true

process {
    withName: 'OVERRIDE_ME' {
        cpus           = 2
        ext.shared_key = 'from-pipeline'
        scratch        = false
    }
}
