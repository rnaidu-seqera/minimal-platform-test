manifest {
    name            = 'minimal-platform-test'
    description     = 'MRE for FD-7749 — IGV reference genome URL signing (platform#11971)'
    version         = '1.0.0'
    nextflowVersion = '>=23.0.0'
}

params {
    // MUST be the final absolute cloud path (gs://… or az://…). It is baked into the generated IGV
    // config files as the reference genome's fastaURL/indexURL, so a relative path produces configs
    // that point nowhere.
    outdir = 'results'
}

process {
    cpus   = 1
    memory = 2.GB
}

docker.enabled = true
