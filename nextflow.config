manifest {
    name        = 'minimal-platform-test'
    description = 'Minimal pipeline for Seqera Platform testing'
    version     = '1.0.0'
    nextflowVersion = '>=26.02.0-edge'
}

params {
    greeting = "Hello"
    name     = "World"
    outdir   = "s3://scidev-playground-eu-west-2/scratch/testrun"
}

process {
    publishDir = [
        path: { "${params.outdir}/${workflow.platform.workflowId}/${task.process}/" },
        mode: 'copy'
    ]
}
