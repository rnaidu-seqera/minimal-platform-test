manifest {
    name            = 'minimal-platform-test'
    description     = 'MRE for PLAT-5421 — IGV index companion presigning (platform#11324)'
    version         = '1.0.0'
    nextflowVersion = '>=23.0.0'
}

params {
    // Override this in the launch form with a gs:// path inside a bucket your GCP credentials
    // can see, so the fixtures land somewhere Data Explorer will surface as a data link.
    outdir = 'results'
}

process {
    // Fixtures are tiny; the defaults are plenty and keep the GCP Batch machine type small.
    cpus   = 1
    memory = 2.GB
}

// Docker is required by the GCP Batch executor; harmless when running locally with -profile.
docker.enabled = true

/*
 * Surfaces the fixtures in the run's Reports tab, which is the second view the PR changes
 * (workflow-launch-reports.component.ts). Report paths are resolved relative to the launch
 * directory, so these globs are intentionally loose — if a fixture doesn't show up here, fall
 * back to Data Explorer, which is the surface the PR's own test plan uses.
 */
tower {
    reports {
        '**/sample.bam' {
            display = 'Indexed BAM (sample.bam)'
        }
        '**/unindexed.bam' {
            display = 'BAM with no index (unindexed.bam)'
        }
        '**/variants.vcf.gz' {
            display = 'Indexed VCF (variants.vcf.gz)'
        }
        '**/features.bed' {
            display = 'Plain BED (features.bed)'
        }
    }
}
