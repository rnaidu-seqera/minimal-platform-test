manifest {
    name            = 'minimal-platform-test'
    description     = 'MRE for PLAT-5733 — GCS V4 signing for genomic files (platform#11624)'
    version         = '1.0.0'
    nextflowVersion = '>=23.0.0'
}

params {
    // Override in the launch form with a gs:// path inside a bucket that has a Data Link and a
    // CORS policy exposing Range. Both are hard prerequisites — see README.md.
    outdir = 'results'
}

process {
    cpus   = 1
    memory = 2.GB
}

docker.enabled = true
