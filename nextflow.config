manifest {
    name        = 'minimal-platform-test'
    description = 'Minimal pipeline for Seqera Platform testing'
    version     = '1.0.0'
    nextflowVersion = '>=23.0.0'
}

docker {
    enabled = true
}

profiles {
    fusion {
        fusion {
            enabled = true
            exportStorageCredentials = true
        }
        wave {
            enabled = true
        }
    }
}
