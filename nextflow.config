manifest {
    name            = 'minimal-platform-test'
    description     = 'Minimal pipeline to reproduce Seqera Platform parameter type-coercion issue (FD-7482)'
    version         = '1.0.0'
    nextflowVersion = '>=23.10.0'
}

plugins {
    id 'nf-schema@2.3.0'
}

params {
    call_min_reads = "1"
}

docker {
    enabled = true
}

validation {
    help {
        enabled = true
    }
    lenientMode = false
}
